rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Só a sua conta do Google (login no site) lê e grava.
    // O robô diário entra com a conta de serviço (segredo FIREBASE_SA), que não passa por estas regras.
    // Ao colar no Firebase, troque SEU_EMAIL_DO_GOOGLE pelo e-mail da conta que vai entrar no site.
    function eVoce() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == "SEU_EMAIL_DO_GOOGLE";
    }
    match /marcas/{id}      { allow read, write: if eVoce(); }
    match /documentos/{id}  { allow read, write: if eVoce(); }
    match /pedidos_ia/{id}  { allow read, write: if eVoce(); }
    match /config/{id}      { allow read, write: if eVoce(); }
  }
}
